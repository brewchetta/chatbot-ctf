# Copy this file to .env.local and fill in your group's key.
# .env.local is gitignored and the file tools can never read it (range safety).
ANTHROPIC_API_KEY=

# 0 = naive, 1 = prompt hardening, 2 = filtering, 3 = least privilege, custom = lib/defenses/student.ts
DEFENSE_LEVEL=0

# Optional model override. Default is claude-haiku-4-5 (easier to inject, which suits the exercise).
# "Hard mode": the newer model refuses most attacks on its own.
# ANTHROPIC_MODEL=claude-haiku-5-5
